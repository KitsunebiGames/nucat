name "nucat"
dependency "dplug:canvas" version="~>13.7.10"
dependency "dplug:au" version="~>13.7.10"
dependency "dplug:dsp" version="~>13.7.10"
dependency "dplug:pbr-widgets" version="~>13.7.10"
dependency "ddsp" version="~>2.6.1"
dependency "dplug:lv2" version="~>13.7.10"
dependency "dplug:core" version="~>13.7.10"
dependency "dplug:vst3" version="~>13.7.10"
dependency "dplug:client" version="~>13.7.10"
dependency "dplug:gui" version="~>13.7.10"
targetType "dynamicLibrary"
targetPath "out/"
dflags "-defaultlib=libphobos2.a" platform="linux-dmd"
dflags "-fvisibility=hidden" platform="linux-x86_64-ldc"
dflags "-static" platform="osx-ldc"
dflags "-mscrtlib=libcmt" "-fvisibility=hidden" "-link-defaultlib-shared=false" platform="windows-ldc"
dflags "-link-defaultlib-shared=false" platform="linux-ldc"
versions "futureMouseDrag" "legacyMouseCursor"
importPaths "source/"
stringImportPaths "." "res/"

configuration "VST3" {
	targetType "dynamicLibrary"
	versions "VST3"
}

configuration "LV2" {
	targetType "dynamicLibrary"
	versions "LV2"
}

configuration "AU" {
	targetType "dynamicLibrary"
	versions "AU"
}
